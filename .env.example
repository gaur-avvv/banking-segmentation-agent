# Copy to .env and replace the blank value locally. Never commit .env.
GEMINI_API_KEY=
# Hosted Gemma 4 model; override when your account enables a different model.
GEMINI_MODEL=gemma-4-26b-a4b-it
# Optional provider selection: auto, gemini, openai, openai-compatible, or none.
LLM_PROVIDER=auto
# OpenAI or OpenAI-compatible provider. OPEN_AI_API and OPENAI_API are accepted aliases.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set for OpenRouter, Azure-compatible gateways, or a local OpenAI-compatible server.
OPENAI_BASE_URL=
# OpenRouter: use `openrouter/free` for the provider's current free router,
# or set a specific model with a `:free` variant when available.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Groq OpenAI-compatible endpoint.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Local Ollama OpenAI-compatible endpoint (no API key required).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b
